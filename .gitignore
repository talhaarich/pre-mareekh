# ---------- Data: big files stay out of git (share by drive link) ----------
# Keep the folders alive with an empty .gitkeep file in each.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.tif
*.tiff
*.img
*.jp2
*.cub
*.zip
*.7z
*.tar.gz

# NOTE: web/public/data (tiles, grids, manifest.json, meda.json) IS committed.
# GitHub rejects any single file over 100 MB. If the tiles grow too big,
# stop committing them and host them somewhere else.